NODE_ENV=development
PORT=3333
HOST=0.0.0.0

DATABASE_URL="postgresql://clinica:clinica@localhost:5432/clinica_escola?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-32-chars-ou-mais
# Expiração da sessão (ex.: 15m, 8h)
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# Rate limit global e do login (tentativas por janela)
RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=15 minutes

# Senha dos usuários criados pelo seed (apenas desenvolvimento)
SEED_PASSWORD=Trocar@123
